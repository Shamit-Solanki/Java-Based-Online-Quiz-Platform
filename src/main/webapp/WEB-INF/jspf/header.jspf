<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" isErrorPage="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="me" value="${sessionScope.user}"/>
<c:set var="role" value="${empty me ? '' : me.role.name()}"/>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="csrf" content="<c:out value='${sessionScope.csrf}'/>">
<title><c:out value="${pageTitle}"/> · <c:out value="${empty platformName ? 'QuizMania' : platformName}"/></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap">
<link rel="stylesheet" href="${ctx}/css/style.css">
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.dataset.theme=t;}catch(e){}</script>
</head>
<body class="${nav == 'take' ? 'focus-mode' : 'app'}">
<c:if test="${not empty me && nav != 'take'}">
<aside class="sidebar" id="sidebar">
  <a class="brand" href="${ctx}${me.dashboardPath}"><span class="brand-mark">QM</span><span><c:out value="${platformName}"/></span></a>
  <nav class="side-nav">
  <c:choose>
    <c:when test="${role == 'ADMIN'}">
      <a class="${nav=='dashboard'?'active':''}" href="${ctx}/admin/dashboard"><i>▦</i>Dashboard</a>
      <a class="${nav=='users'?'active':''}" href="${ctx}/admin/users"><i>☺</i>Users</a>
      <a class="${nav=='quizzes'?'active':''}" href="${ctx}/admin/quizzes"><i>✎</i>Quiz content</a>
      <a class="${nav=='reports'?'active':''}" href="${ctx}/admin/reports"><i>▤</i>Reports</a>
      <a class="${nav=='settings'?'active':''}" href="${ctx}/admin/settings"><i>⚙</i>Settings</a>
    </c:when>
    <c:when test="${role == 'CREATOR'}">
      <a class="${nav=='dashboard'?'active':''}" href="${ctx}/creator/dashboard"><i>▦</i>Dashboard</a>
      <a class="${nav=='create'?'active':''}" href="${ctx}/creator/quiz-form"><i>＋</i>Create quiz</a>
      <a class="${nav=='quizzes'?'active':''}" href="${ctx}/creator/quizzes"><i>✎</i>My quizzes</a>
      <a class="${nav=='results'?'active':''}" href="${ctx}/creator/results"><i>✓</i>Results</a>
      <a class="${nav=='messages'?'active':''}" href="${ctx}/messages"><i>✉</i>Messages<c:if test="${unreadMessages > 0}"><b class="pill">${unreadMessages}</b></c:if></a>
    </c:when>
    <c:otherwise>
      <a class="${nav=='dashboard'?'active':''}" href="${ctx}/participant/dashboard"><i>▦</i>Dashboard</a>
      <a class="${nav=='quizzes'?'active':''}" href="${ctx}/participant/quizzes"><i>▶</i>Take a quiz</a>
      <a class="${nav=='reports'?'active':''}" href="${ctx}/participant/reports"><i>▤</i>My reports</a>
      <a class="${nav=='leaderboard'?'active':''}" href="${ctx}/participant/leaderboard"><i>★</i>Leaderboard</a>
      <a class="${nav=='reminders'?'active':''}" href="${ctx}/participant/reminders"><i>⏰</i>Reminders</a>
      <a class="${nav=='messages'?'active':''}" href="${ctx}/messages"><i>✉</i>Messages<c:if test="${unreadMessages > 0}"><b class="pill">${unreadMessages}</b></c:if></a>
    </c:otherwise>
  </c:choose>
  </nav>
  <div class="side-foot">
    <a class="user-chip ${nav=='profile'?'active':''}" href="${ctx}/profile">
      <span class="avatar"><c:out value="${me.initials}"/></span>
      <span><b><c:out value="${me.name}"/></b><small><c:out value="${me.role.label}"/></small></span>
    </a>
    <form method="post" action="${ctx}/logout"><button class="btn ghost block" type="submit">Sign out</button></form>
  </div>
</aside>
<div class="scrim" id="scrim"></div>
</c:if>
<div class="${nav == 'take' ? 'focus-wrap' : 'main-wrap'}">
<c:if test="${not empty me && nav != 'take'}">
<header class="topbar">
  <button class="icon-btn menu-btn" id="menuBtn" aria-label="Menu">☰</button>
  <h1 class="page-title"><c:out value="${pageTitle}"/></h1>
  <div class="top-actions">
    <button class="icon-btn" id="themeBtn" title="Toggle dark mode" aria-label="Toggle dark mode">◐</button>
    <a class="icon-btn bell" href="${ctx}/notifications" title="Notifications" aria-label="Notifications">🔔<c:if test="${unreadNotifications > 0}"><b class="dot">${unreadNotifications}</b></c:if></a>
  </div>
</header>
</c:if>
<c:if test="${not empty announcement && not empty me && nav != 'take'}"><div class="announce">📢 <c:out value="${announcement}"/></div></c:if>
<main class="content">
<c:if test="${not empty sessionScope.flash}">
  <div class="flash-data" data-type="${sessionScope.flash[0]}" data-text="<c:out value='${sessionScope.flash[1]}'/>" hidden></div>
  <c:remove var="flash" scope="session"/>
</c:if>
